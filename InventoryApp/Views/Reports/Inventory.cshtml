@model InventoryApp.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Inventory Report";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center rounded-top">
                    <h2 class="mb-0">Inventory Report</h2>
                    <a asp-action="InventoryCsv" class="btn btn-success">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </a>
                </div>
                <div class="card-body bg-light">
                    <!-- Date filter -->
                    <form method="get" asp-action="Inventory" class="mb-4">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label fw-bold" for="from">From</label>
                                <input type="date" name="from" id="from" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold" for="to">To</label>
                                <input type="date" name="to" id="to" class="form-control" />
                            </div>
                            <div class="col-md-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary flex-fill">
                                    <i class="bi bi-funnel"></i> Filter
                                </button>
                                <a asp-action="InventoryCsv" class="btn btn-outline-success flex-fill">
                                    <i class="bi bi-download"></i> CSV
                                </a>
                            </div>
                        </div>
                    </form>

                    <!-- KPIs -->
                    <div class="row mb-4 g-3">
                        <div class="col-md-4">
                            <div class="card text-center border-0 shadow-sm h-100 bg-white">
                                <div class="card-body">
                                    <div class="mb-2 text-secondary">
                                        <i class="bi bi-box-seam display-6"></i>
                                    </div>
                                    <h6 class="fw-bold">Total Products</h6>
                                    <h3 class="text-primary">@Model.TotalProducts</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center border-0 shadow-sm h-100 bg-white">
                                <div class="card-body">
                                    <div class="mb-2 text-secondary">
                                        <i class="bi bi-stack display-6"></i>
                                    </div>
                                    <h6 class="fw-bold">Total Quantity</h6>
                                    <h3 class="text-success">@Model.TotalQuantity</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center border-0 shadow-sm h-100 bg-white">
                                <div class="card-body">
                                    <div class="mb-2 text-secondary">
                                        <i class="bi bi-currency-dollar display-6"></i>
                                    </div>
                                    <h6 class="fw-bold">Total Value</h6>
                                    <h3 class="text-danger">@Model.TotalInventoryValue.ToString("C")</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top 5 by Value -->
                    <div class="mb-4">
                        <h4 class="fw-bold text-primary">Top 5 Products by Value</h4>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Name</th>
                                        <th>Quantity</th>
                                        <th>Line Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Top5ByValue)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.LineValue.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Low Stock -->
                    <div>
                        <h4 class="fw-bold text-danger">Low Stock Items (Qty &lt; 5)</h4>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-danger">
                                    <tr>
                                        <th>Name</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LowStockItems)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td>@item.Quantity</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>